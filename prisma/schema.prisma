generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Compensation {
  id                  String   @id @default(cuid())

  company             String
  normalizedCompany   String

  role                String
  level               String
  location            String

  baseSalary          Int
  bonus               Int @default(0)
  stock               Int @default(0)

  totalComp           Int

  experience          Int

  createdAt           DateTime @default(now())

  @@index([company])
  @@index([normalizedCompany])
  @@index([role])
  @@index([level])
  @@index([location])

  @@unique([normalizedCompany, role, level, location, experience, totalComp])
}